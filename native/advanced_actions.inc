    bool advanced_action(int command){
        switch(command){
        case ReplayStart:{if(recorder.active())throw std::runtime_error("Stop normal recording before starting replay buffering");const unsigned values[]={30,60,120};unsigned seconds=values[advanced_choice(replay_seconds,3)];store.set("replay.seconds",std::to_string(seconds));store.save();replay->start(capture_options(),seconds);say(L"Replay buffering is recording the approved desktop region. Ctrl+Alt+F9 saves the available tail.");return true;}
        case ReplayStop:replay->stop();say(L"Replay buffer stopped; saved clips are preserved.");return true;
        case ReplaySave:{if(replay_saving)throw std::runtime_error("Wait for the replay export or cancel it");unsigned seconds=static_cast<unsigned>(std::stoul(store.get("replay.seconds","60")));replay_cancel=std::make_shared<std::atomic<bool>>(false);auto cancel=replay_cancel;auto buffer=replay;replay_saving=true;SetWindowTextW(replay_last,L"Saving replay... The buffer continues recording.");update_advanced();auto game=selected_game();async("advanced-replay",[buffer,seconds,cancel,game](Result& r){r.text=hr::utf8(buffer->save(seconds,*cancel).wstring());r.game=game;});say(L"Saving the available replay tail; the buffer continues recording.");return true;}
