        case ReplayPrivacy:open_hub_tool("capture-privacy");return true;
        case ReplayOpen:if(last_replay.empty()||!std::filesystem::exists(last_replay))throw std::runtime_error("Save a replay first");hr::shell(last_replay.wstring());return true;
        case MicRefresh:case DevicesRefresh:if(microphone.active())throw std::runtime_error("Stop the microphone test before refreshing devices");scan_advanced_devices();return true;
        case MicStart:{unsigned times[]={5,10,20,30,60};auto endpoint=mic_ids.at(advanced_choice(mic_source,static_cast<int>(mic_ids.size())));microphone.start(endpoint,times[advanced_choice(mic_duration,5)]);return true;}
        case MicStop:microphone.stop();return true;
        case MicPlayback:if(microphone.active()||microphone.file().empty())throw std::runtime_error("Record and save a microphone test first");hr::shell(microphone.file().wstring());return true;
        case DeviceSave:{hr::DeviceProfile profile;profile.name=hr::utf8(text(device_name));if(SendMessageW(device_include_display,BM_GETCHECK,0,0)==BST_CHECKED){auto current=hr::current_displays();auto index=advanced_choice(device_mode,static_cast<int>(advanced_modes.size()+1));if(index){auto selected=advanced_modes.at(index-1);bool matched=false;for(auto& display:current)if(display.device==selected.device){selected.x=display.x;selected.y=display.y;display=selected;matched=true;}if(!matched)throw std::runtime_error("The selected display disconnected");}profile.displays=hr::encode_displays(current);}if(audio_switch_supported){profile.playback=playback_ids.at(advanced_choice(device_playback,static_cast<int>(playback_ids.size())));profile.microphone=microphone_ids.at(advanced_choice(device_microphone,static_cast<int>(microphone_ids.size())));}hr::save_device_profile(store,profile);refresh_device_profiles();say(L"Monitor/audio profile saved. Preview applies it with timed rollback.");return true;}
        case DeviceApply:{if(sessions.active())throw std::runtime_error("End the automatic game session before manually applying a device profile");int index=selection(lists[27]);if(index<0||static_cast<size_t>(index)>=advanced_device_profiles.size())throw std::runtime_error("Select a saved device profile");auto profile=hr::read_device_profile(advanced_device_profiles[index]);hr::SessionSettings settings;settings.displays=profile.displays;settings.playback=profile.playback;settings.microphone=profile.microphone;if(!confirm(hr::wide("Preview device profile: "+profile.name+"\n\nThis can change the current display layout and default playback/microphone devices. A 15-second Keep / Revert dialog follows. The watchdog restores original settings on timeout or app failure. Some applications need restarting to adopt audio changes.")))return true;hr::SettingsGuard preview(hr::own_process(),settings,20);if(hr::app_timed_confirm(window,L"Keep this device profile?",L"Keep these display/audio settings?\n\nChoose Keep settings within 15 seconds. Revert, closing this popup or timeout restores the original values. The crash watchdog remains active until confirmation.",15,light_theme)){preview.keep();store.set("device.last-change",hr::utf8(preview.recovery_file().wstring()));store.log("Device profile applied",profile.name);say(L"Device profile applied to the current desktop.");}else say(L"Device profile preview reverted.");return true;}
        case DeviceUndo:{if(sessions.active())throw std::runtime_error("End the automatic game session before reverting a manual device profile");auto file=store.get("device.last-change");if(file.empty())throw std::runtime_error("No confirmed device profile remains to revert");if(!confirm(L"Restore the exact display/audio values from before the last confirmed device profile? External changes are preserved and reported as conflicts."))return true;auto result=hr::undo_device_preview(hr::wide(file));store.set("device.last-change","");store.log("Device profile revert",result);SetWindowTextW(device_note,hr::wide(result).c_str());return true;}
        case DeviceDelete:{int index=selection(lists[27]);if(index<0||static_cast<size_t>(index)>=advanced_device_profiles.size())throw std::runtime_error("Select a saved profile");auto profile=hr::read_device_profile(advanced_device_profiles[index]);auto key="device.profile."+hr::hex(hr::lower(profile.name));store.rows.erase(std::remove_if(store.rows.begin(),store.rows.end(),[&](const hr::Row& row){return row[0]=="setting"&&row[1]==key;}),store.rows.end());store.save();refresh_device_profiles();SetWindowTextW(device_name,L"");return true;}
        case ProfileBrowse:{auto folder=hr::app_folder(window,L"Choose this game's personal save folder",light_theme);if(!folder.empty()){hr::validate_backup_folder(folder);SetWindowTextW(profile_folder,folder.c_str());}return true;}
        case ProfileSave:{auto profile=edited_game_profile();if(!confirm(hr::wide(hr::profile_review(profile))))return true;hr::save_game_profile(store,profile);if(!profile.enabled&&hr::lower(sessions.active_game())==hr::lower(profile.game))sessions.stop("Automatic profile disabled");load_game_profile();store.log("Game profile approved",profile.game);say(L"Game profile saved; approved settings apply when that exact executable is detected.");return true;}
        case ProfileSleep:open_hub_tool("background-sleep");return true;
        case ProfileBackupNow:{if(profile_busy)throw std::runtime_error("A save operation is already running");auto profile=hr::game_profile(store,profile_game_path());if(profile.backup_folder.empty())throw std::runtime_error("Save an approved personal save folder in this profile first");if(hr::gaming_now(store))throw std::runtime_error("Close registered games before manually backing up saves");profile_busy=true;auto cancel=std::make_shared<std::atomic<bool>>(false);async("advanced-backup",[profile,cancel](Result& r){r.game=profile.game;r.text=hr::automatic_backup(profile.game,hr::wide(profile.backup_folder),profile.retention,*cancel);});SetWindowTextW(profile_note,L"Creating a locked-file, SHA-256-verified save snapshot...");return true;}
        case ProfileRestore:{if(profile_busy)throw std::runtime_error("Wait for the save operation");if(hr::gaming_now(store))throw std::runtime_error("Close registered games before restoring saves");int index=selection(lists[25]);if(index<0||static_cast<size_t>(index)>=profile_versions.size())throw std::runtime_error("Select a backup version");auto version=profile_versions[index];if(!confirm(hr::wide("Restore save backup from "+version[2]+"?\n\nOriginal folder: "+version[4]+"\nMatching files will be replaced. Extra files are preserved. A before-restore snapshot is created first; all backup hashes are validated before writing.")))return true;profile_busy=true;auto cancel=std::make_shared<std::atomic<bool>>(false);async("advanced-restore",[version,cancel](Result& r){r.game=version[1];r.text=hr::restore_snapshot(hr::wide(version[3]),hr::wide(version[4]),*cancel);});return true;}
        case MaintenanceSave:{auto plan=edited_maintenance();if(plan.enabled){std::string review="Approve this maintenance scope?\n\nAutomatic runs wait "+std::to_string(plan.idle_minutes)+" idle minutes, run no more often than every "+std::to_string(plan.interval_minutes)+" minutes and defer registered games/fullscreen apps.\n";if(plan.cleanup)review+="PERMANENT cleanup: only regular user-temp files older than 24 hours, capped at 2,000 files / 256 MB per run. Changed, linked, locked and out-of-scope files are skipped.\n";if(plan.backups)review+="Versioned saves for enabled game profiles, using each explicitly approved folder and retention count.\n";review+=plan.background?"A current-user, elevated interactive Windows task checks these conditions every 30 minutes while NovaTune is closed. No password is stored.":"Runs only while NovaTune is open.";if(!confirm(hr::wide(review)))return true;}hr::save_maintenance_plan(store,plan);try{hr::schedule_maintenance(plan,plan.enabled&&plan.background);}catch(const std::exception& e){if(plan.background){plan.background=false;hr::save_maintenance_plan(store,plan);}load_maintenance_editor();throw std::runtime_error(std::string("Plan saved for in-app use; Windows task registration/removal failed: ")+e.what());}load_maintenance_editor();next_maintenance_check=GetTickCount64()+30000;SetWindowTextW(maintenance_output,plan.enabled?L"Approved schedule saved. Automatic runs wait for due time, idle time, power and game checks.":L"Maintenance disabled. Its owned Windows task was removed.");return true;}
        case MaintenanceRun:start_maintenance(true);return true;
        case MaintenanceHistory:SetWindowTextW(maintenance_output,hr::wide(hr::maintenance_status()).c_str());return true;
        case ModsChoose:{if(mod_busy)throw std::runtime_error("Wait for the mod operation");auto folder=hr::app_folder(window,L"Choose only a dedicated mod folder",light_theme);if(!folder.empty()){hr::validate_mod_folder(folder);SetWindowTextW(mod_folder,folder.c_str());}return true;}
        case ModsSave:{if(mod_busy)throw std::runtime_error("Wait for the mod operation");auto folder=std::filesystem::path(text(mod_folder));auto name=hr::utf8(text(mod_name));if(name.empty()||name.size()>160)throw std::runtime_error("Enter a mod-set name up to 160 UTF-8 bytes");hr::validate_mod_folder(folder);if(hr::gaming_now(store))throw std::runtime_error("Close registered games before capturing a mod set");mod_busy=true;mod_cancel=std::make_shared<std::atomic<bool>>(false);auto cancel=mod_cancel;async("advanced-mod-save",[folder,name,cancel](Result& r){auto path=hr::snapshot_folder(folder,"Mod set: "+name,*cancel,true);r.record={"1",name,hr::utf8(std::filesystem::weakly_canonical(folder).wstring()),hr::utf8(path.wstring()),"",hr::now()};});SetWindowTextW(mod_note,L"Capturing a complete mod-set snapshot. Links and busy files are refused.");return true;}
        case ModsPreview:{if(mod_busy)throw std::runtime_error("Wait for the mod operation");int index=selection(lists[29]);if(index<0||static_cast<size_t>(index)>=mod_profiles.size())throw std::runtime_error("Select a saved mod set or imported recovery snapshot");auto path=mod_profiles[index][3];mod_busy=true;clear_mod_review();async("advanced-mod-preview",[path](Result& r){r.mod_plan=std::make_shared<hr::ModPlan>(hr::plan_mod_switch(hr::wide(path)));});return true;}
        case ModsApply:{if(mod_busy||!reviewed_mod)throw std::runtime_error("Preview a saved mod set first");if(hr::gaming_now(store))throw std::runtime_error("Close registered games before switching mods");auto plan=reviewed_mod;std::ostringstream review;review<<"Apply "<<plan->changes.size()<<" reviewed mod-file changes?\n\nFolder: "<<hr::utf8(plan->target.wstring())<<"\nA complete before-switch snapshot is created before any write/removal. This operation only mirrors the dedicated mod folder.\n\n";for(size_t n=0;n<std::min<size_t>(200,plan->changes.size());++n){const auto& row=plan->changes[n];review<<(row[1].empty()?"ADD":row[2].empty()?"REMOVE":"REPLACE")<<"  "<<row[0]<<"\n";}if(plan->changes.size()>200)review<<"Further changes remain listed in the on-page preview.\n";if(!confirm(hr::wide(review.str())))return true;mod_busy=true;mod_cancel=std::make_shared<std::atomic<bool>>(false);auto cancel=mod_cancel;auto snapshot=store;async("advanced-mod-apply",[plan,cancel,snapshot](Result& r){unsigned long long checked=0;bool permitted=false;r.text=hr::apply_mod_switch(*plan,*cancel,[&]{if(GetTickCount64()-checked>500){checked=GetTickCount64();permitted=!hr::gaming_now(snapshot);}return permitted;});});return true;}
        case ModsRecovery:hr::app_dialog(window,L"Mod switch recovery",hr::wide(hr::mod_switch_history()),false,light_theme);return true;
        case ModsImport:{if(mod_busy)throw std::runtime_error("Wait for the mod operation");auto folder=hr::app_folder(window,L"Choose a NovaTune before-switch snapshot",light_theme);if(folder.empty())return true;auto plan=hr::plan_mod_switch(folder);auto name="Recovery "+hr::now();hr::Row row{"1",name,hr::utf8(plan.target.wstring()),hr::utf8(plan.snapshot.wstring()),"",hr::now()};store.set("mod.profile."+hr::hex(row[3]),hr::encode({row}));store.save();refresh_mod_profiles();say(L"Recovery snapshot added. Select it, preview and approve its exact changes.");return true;}
        case ModsRemove:{if(mod_busy)throw std::runtime_error("Wait for the mod operation");int index=selection(lists[29]);if(index<0||static_cast<size_t>(index)>=mod_profiles.size())throw std::runtime_error("Select a saved mod set");auto key="mod.profile."+hr::hex(mod_profiles[index][3]);store.rows.erase(std::remove_if(store.rows.begin(),store.rows.end(),[&](const hr::Row& row){return row[0]=="setting"&&row[1]==key;}),store.rows.end());store.save();refresh_mod_profiles();SetWindowTextW(mod_note,L"Saved set removed from the list. Snapshot files are preserved for recovery.");return true;}
        case ModsCancel:*mod_cancel=true;SetWindowTextW(mod_note,L"Cancellation requested. Any applied file changes are rolled back unless they were changed externally.");return true;
        case TimelineStart:{auto game=timeline_games.at(advanced_choice(timeline_game,static_cast<int>(timeline_games.size())));auto executable=store.get("presentmon");if(executable.empty())throw std::runtime_error("Choose and save the PresentMon executable in Settings first");live.start(executable,game);overlay_game=game;timeline_requested=true;timeline_frozen=false;timeline_chosen=0;SetWindowTextW(timeline_freeze_button,L"Freeze view");refresh_timeline();say(L"Live frame/resource trace started. The feed is shared with the HUD.");return true;}
        case TimelineStop:live.stop();timeline_requested=false;timeline_frozen=true;SetWindowTextW(timeline_freeze_button,L"Resume view");say(L"PresentMon capture stopped; the retained timeline remains visible.");return true;
        case TimelineFreeze:timeline_frozen=!timeline_frozen;SetWindowTextW(timeline_freeze_button,timeline_frozen?L"Resume view":L"Freeze view");if(!timeline_frozen)refresh_timeline();return true;
        case TimelineExport:export_timeline();return true;
        }return false;
    }
    bool advanced_result(Result& r){
        if(r.kind.rfind("advanced-",0)!=0)return false;if(r.kind=="advanced-replay")replay_saving=false;if(r.kind=="advanced-auto-backup")automatic_backup_busy=false;if(r.kind=="advanced-devices")advanced_device_busy=false;if(r.kind=="advanced-launch"||r.kind=="advanced-backup"||r.kind=="advanced-restore")profile_busy=false;if(r.kind=="advanced-maintenance")maintenance_busy=false;if(r.kind.rfind("advanced-mod-",0)==0)mod_busy=false;
        if(!r.error.empty()){if(r.kind=="advanced-replay")SetWindowTextW(replay_last,hr::wide("Replay was not saved: "+r.error).c_str());if(r.kind=="advanced-maintenance"){SetWindowTextW(maintenance_output,hr::wide(r.error).c_str());if(r.mode=="manual")failure(r.error);else say(hr::wide("Automatic maintenance deferred/failed: "+r.error));}else if(r.kind=="advanced-auto-backup"){sessions.add_event("Save backup failed",r.error);store.log("Automatic save backup failed",r.error);say(hr::wide("Save backup failed: "+r.error));}else{if(r.kind.rfind("advanced-mod-",0)==0)SetWindowTextW(mod_note,hr::wide(r.error).c_str());if(r.kind=="advanced-launch")r.error="Save backup failed; game was not launched.\n"+r.error;failure(r.error);}update_advanced();return true;}
        if(r.kind=="advanced-devices"){advanced_audio=std::move(r.audio);advanced_displays=std::move(r.displays);audio_switch_supported=r.mode=="supported";fill_advanced_devices();}
        else if(r.kind=="advanced-replay"){last_replay=hr::wide(r.text);if(!r.game.empty())store.set(gallery_key(last_replay),hr::encode({{"Replay",r.game}}));store.log("Replay saved",r.text);SetWindowTextW(replay_last,(L"Saved: "+last_replay.wstring()).c_str());say(L"Replay saved; buffering continues unless stopped.");if(page==22)scan_gallery();}
        else if(r.kind=="advanced-launch"){if(std::none_of(games.begin(),games.end(),[&](const hr::Row& game){return hr::lower(game[2])==hr::lower(r.game);})){say(L"Game was removed while backing up; launch canceled. Its completed backup was preserved.");return true;}launch_backup_ticks[hr::lower(r.game)]=GetTickCount64();hr::launch(hr::wide(r.game));store.log("Game launched after save backup",r.game+" / "+r.text);say(L"Save backup completed; game launched.");refresh_profile_versions();}
        else if(r.kind=="advanced-backup"||r.kind=="advanced-auto-backup"||r.kind=="advanced-restore"){store.log(r.kind=="advanced-restore"?"Save backup restored":"Automatic save snapshot",r.game+" / "+r.text);sessions.add_event("Save backup",r.text);SetWindowTextW(profile_note,hr::wide(r.text).c_str());if(!profile_games.empty())refresh_profile_versions();}
        else if(r.kind=="advanced-maintenance"){SetWindowTextW(maintenance_output,hr::wide(r.text).c_str());if(r.text.find("scheduled maintenance")!=std::string::npos)store.log("Approved maintenance completed",r.text);if(r.mode=="manual")say(hr::wide(r.text.substr(0,180)));}
        else if(r.kind=="advanced-mod-save"){store.set("mod.profile."+hr::hex(r.record[3]),hr::encode({r.record}));store.save();refresh_mod_profiles();SetWindowTextW(mod_note,L"Mod set saved. Capture an empty dedicated mod folder to preserve a clean baseline.");}
        else if(r.kind=="advanced-mod-preview"){reviewed_mod=r.mod_plan;ListView_DeleteAllItems(mod_changes);for(const auto& row:reviewed_mod->changes)add(mod_changes,{row[1].empty()?L"Add":row[2].empty()?L"Remove":L"Replace",hr::wide(row[0])});EnableWindow(mod_apply,TRUE);SetWindowTextW(mod_note,(std::to_wstring(reviewed_mod->changes.size())+L" exact changes reviewed for "+reviewed_mod->target.wstring()+L". Apply revalidates this preview and backs up the current set first.").c_str());}
        else if(r.kind=="advanced-mod-apply"){store.log("Reviewed mod switch",r.text);clear_mod_review();SetWindowTextW(mod_note,hr::wide(r.text).c_str());}
        update_advanced();return true;
    }
