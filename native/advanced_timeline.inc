    void refresh_timeline(){
        if(!timeline_frozen){timeline_frames=live.frames();timeline_resources.assign(resource_history.begin(),resource_history.end());}if(timeline_frames.empty()){SetWindowTextW(timeline_note,L"No live frame intervals retained. Select a game, configure PresentMon in Settings, then Start live trace. Charts never invent GPU or frame data.");ListView_DeleteAllItems(lists[30]);return;}if(!timeline_chosen||timeline_chosen<timeline_frames.front().first||timeline_chosen>timeline_frames.back().first)timeline_chosen=timeline_frames.back().first;describe_timeline();
    }
    void describe_timeline(){
        if(timeline_frames.empty())return;const std::pair<unsigned long long,double>* nearest_frame=nullptr;unsigned long long nearest_distance=~0ULL;for(const auto& frame:timeline_frames){auto distance=frame.first>timeline_chosen?frame.first-timeline_chosen:timeline_chosen-frame.first;if(distance<nearest_distance){nearest_distance=distance;nearest_frame=&frame;}}if(!nearest_frame)return;std::vector<unsigned long long> ticks;for(const auto& point:timeline_resources)ticks.push_back(point.tick);auto index=hr::nearest_tick(ticks,nearest_frame->first,2500);std::wostringstream report;report<<L"Selected interval "<<number(nearest_frame->second,2)<<L" ms / "<<number((timeline_frames.back().first-nearest_frame->first)/1000.0,2)<<L" seconds before last retained frame. Metric: "<<hr::wide(live.metric())<<L". ";ListView_DeleteAllItems(lists[30]);if(index<timeline_resources.size()){const auto& point=timeline_resources[index];auto delta=point.tick>nearest_frame->first?point.tick-nearest_frame->first:nearest_frame->first-point.tick;report<<L"Nearest resource sample is "<<delta<<L" ms away: CPU "<<number(point.cpu)<<L"%, RAM "<<number(point.ram)<<L"%, GPU "<<(point.gpu<0?L"unavailable":number(point.gpu)+L"%")<<L". ";for(const auto& process:point.processes)add(lists[30],{process.name,number(process.cpu),number(process.ram)});}else report<<L"No resource sample is within 2.5 seconds. ";report<<L"Timing uses capture receipt, not game-engine timestamps; sampled associations do not prove a cause.";if(!live.error().empty())report<<L" Capture: "<<hr::wide(live.error());SetWindowTextW(timeline_note,report.str().c_str());
    }
    void timeline_click(HWND chart){if(timeline_frames.empty())return;POINT point{};GetCursorPos(&point);ScreenToClient(chart,&point);RECT bounds{};GetClientRect(chart,&bounds);auto end=timeline_frames.back().first,begin=end>60000?end-60000:0;double fraction=std::clamp((point.x-52)/static_cast<double>(std::max(1L,bounds.right-72)),0.0,1.0);timeline_chosen=begin+static_cast<unsigned long long>((end-begin)*fraction);describe_timeline();InvalidateRect(timeline_frames_view,nullptr,FALSE);InvalidateRect(timeline_resources_view,nullptr,FALSE);}
    void export_timeline(){if(timeline_frames.empty())throw std::runtime_error("Start a trace before exporting frame data");if(!confirm(L"Export the visible frame and resource samples to a new local CSV in your capture folder?\n\nThe file includes process names, sampled CPU/RAM/GPU values, capture-receive offsets and frame intervals. Timing is approximate and does not prove a stutter's cause."))return;static unsigned sequence=0;auto file=hr::capture_folder()/(L"Timeline-"+std::to_wstring(GetTickCount64())+L"-"+std::to_wstring(GetCurrentProcessId())+L"-"+std::to_wstring(++sequence)+L".csv");auto quote=[](std::string value){size_t where=0;while((where=value.find('"',where))!=std::string::npos){value.insert(where,1,'"');where+=2;}return "\""+value+"\"";};auto origin=timeline_frames.front().first;std::ostringstream output;output<<"kind,receive_offset_seconds,frame_interval_ms,cpu_percent,ram_percent,gpu_percent,process,process_cpu_percent,process_ram_mb\n";for(const auto& frame:timeline_frames)output<<"frame,"<<static_cast<double>(static_cast<long long>(frame.first)-static_cast<long long>(origin))/1000<<","<<frame.second<<",,,,,,\n";for(const auto& point:timeline_resources){if(point.tick+2500<origin||point.tick>timeline_frames.back().first+2500)continue;double elapsed=(static_cast<long long>(point.tick)-static_cast<long long>(origin))/1000.0;output<<"resource,"<<elapsed<<",,"<<point.cpu<<","<<point.ram<<","<<(point.gpu<0?"":hr::utf8(number(point.gpu)))<<",,,\n";for(const auto& process:point.processes)output<<"process,"<<elapsed<<",,,,,"<<quote(hr::utf8(process.name))<<","<<process.cpu<<","<<process.ram<<"\n";}hr::atomic_write(file,output.str());store.log("Timeline exported",hr::utf8(file.wstring()));say(L"Timeline saved: "+file.wstring());}
    bool draw_advanced_item(const DRAWITEMSTRUCT& item){
