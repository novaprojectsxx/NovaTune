        else{bool frames=item.CtlID==1502;label(frames?L"FRAME INTERVALS / milliseconds / last 60 seconds":L"RESOURCE SAMPLES / CPU green   GPU cyan   RAM orange / percent",{0,0,width,24},ink);int left=52,right=width-20,top=34,bottom=height-28;for(int n=0;n<=4;++n){int y=top+(bottom-top)*n/4;line(left,y,right,y,light_theme?RGB(220,224,230):RGB(37,40,46));}if(!timeline_frames.empty()&&right>left&&bottom>top){auto end=timeline_frames.back().first,begin=end>60000?end-60000:0;auto x=[&](unsigned long long tick){return left+static_cast<int>((tick-begin)*static_cast<double>(right-left)/(end-begin));};if(frames){auto bins=hr::timeline_bins(timeline_frames,begin,end,static_cast<size_t>(right-left+1));double maximum=50;for(const auto& bin:bins)if(bin.present)maximum=std::max(maximum,std::min(1000.0,bin.maximum));label(number(maximum,0),{0,top-6,left-4,top+18},ink);label(L"0",{0,bottom-14,left-4,bottom+8},ink);for(size_t n=0;n<bins.size();++n)if(bins[n].present){int y=bottom-static_cast<int>((bottom-top)*bins[n].maximum/maximum);line(left+static_cast<int>(n),bottom,left+static_cast<int>(n),y,RGB(180,95,255),1);}}else{const COLORREF colors[]={RGB(26,242,44),RGB(0,216,255),RGB(255,180,70)};for(int series=0;series<3;++series){bool prior=false;POINT last{};for(const auto& point:timeline_resources){if(point.tick<begin||point.tick>end){prior=false;continue;}double value=series==0?point.cpu:series==1?point.gpu:point.ram;if(value<0){prior=false;continue;}POINT position{x(point.tick),bottom-static_cast<LONG>((bottom-top)*std::clamp(value,0.0,100.0)/100)};if(prior)line(last.x,last.y,position.x,position.y,colors[series],2);last=position;prior=true;}}label(L"100",{0,top-6,left-4,top+18},ink);label(L"0",{0,bottom-14,left-4,bottom+8},ink);}if(timeline_chosen>=begin&&timeline_chosen<=end)line(x(timeline_chosen),top,x(timeline_chosen),bottom,light_theme?RGB(100,100,115):RGB(170,175,190));label(L"-60s",{left,bottom+7,left+70,height},ink);label(L"now",{right-50,bottom+7,right,height},ink);}els