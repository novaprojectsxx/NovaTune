    void refresh_comparison(){bool before=!store.get("compare.before").empty();EnableWindow(GetDlgItem(window,CompareOpen),!store.get("compare.export").empty());EnableWindow(GetDlgItem(window,CompareBefore),!comparison_busy);EnableWindow(GetDlgItem(window,CompareAfter),before&&!comparison_busy);EnableWindow(GetDlgItem(window,CompareExport),before&&!comparison_busy);EnableWindow(GetDlgItem(window,CompareCancel),comparison_busy);SetWindowTextW(GetDlgItem(window,SetupFinish),store.get("onboarding.complete")=="1"?L"Setup complete":L"Finish setup");SetWindowTextW(comparison_state,comparison_busy?L"MEASURING / 4 seconds. Keep your workload steady; no optimizations are applied.":before?L"Baseline saved. Review fixes, return to the same workload, then capture After.\nCPU/RAM changes are observations; use Benchmarks to measure game FPS.":L"Three useful places to start: old temp files, background recording, and startup apps.\nEvery fix stays under your control. Desktop presets can be previewed before applying.");if(comparison_busy)return;try{if(!before){SetWindowTextW(comparison_output,L"Your report will appear here after Capture before.\n\nThe report includes CPU activity, physical RAM in use, process count and measurement context. Export creates a self-contained HTML report without computer name, IP addresses, process names or personal paths.\n\nBoot time and game FPS are never invented from these resource samples.");return;}auto baseline=hr::decode_pc_snapshot(store.get("compare.before"));auto next=store.get("compare.after");std::optional<hr::PcSnapshot> after;if(!next.empty())after=hr::decode_pc_snapshot(next);SetWindowTextW(comparison_output,hr::wide(hr::compare_pc(baseline,after?&*after:nullptr)).c_str());}catch(const std::exception& e){SetWindowTextW(comparison_output,hr::wide(std::string("Saved report could not be read: ")+e.what()+"\nCapture a new baseline to replace it. The original record has been preserved.").c_str());}}
    void capture_comparison(bool after){if(comparison_busy)return;if(after&&store.get("compare.before").empty())throw std::runtime_error("Capture a baseline first");if(!after&&!store.get("compare.before").empty()&&!confirm(L"Replace your baseline and clear its After comparison? Previously exported files are kept."))return;comparison_busy=true;comparison_cancel=std::make_shared<std::atomic<bool>>(false);auto cancel=comparison_cancel;auto mode=store.get("mode","Browsing");refresh_comparison();async(after?"comparison-after":"comparison-before",[cancel,mode](Result& result){auto snapshot=hr::capture_pc_snapshot(*cancel);snapshot.mode=mode;result.text=hr::encode_pc_snapshot(snapshot);});}
    void export_comparison(){if(comparison_busy)throw std::runtime_error("Wait for the measurement to finish");auto before=hr::decode_pc_snapshot(store.get("compare.before"));auto record=store.get("compare.after");std::optional<hr::PcSnapshot> after;if(!record.empty())after=hr::decode_pc_snapshot(record);auto folder=hr::data_dir()/L"reports";std::filesystem::create_directories(folder);auto path=folder/(L"NovaTune-PC-report-"+std::to_wstring(GetTickCount64())+L".html");if(std::filesystem::exists(path))throw std::runtime_error("Report already exists; export again");hr::atomic_write(path,hr::comparison_html(before,after?&*after:nullptr,hr::pc_info()));store.set("compare.export",hr::utf8(path.wstring()));store.save();EnableWindow(GetDlgItem(window,CompareOpen),TRUE);say(L"Report exported: "+path.wstring());SetWindowTextW(comparison_state,(L"EXPORTED / "+path.wstring()+L"\nSelf-contained HTML. Review its timestamps and hardware details before sharing.").c_str());}
