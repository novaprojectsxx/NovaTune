    void cycle_switcher(int direction,int action){if(action==2){if(switcher_window)ShowWindow(switcher_window,SW_HIDE);unthumb();return;}if(action==1){if(switcher_window&&IsWindowVisible(switcher_window))activate_window(selected_window);return;}bool visible=switcher_window&&IsWindowVisible(switcher_window);if(!visible){open_switcher();selected_window=0;}if(!windows.empty())selected_window=(selected_window+direction+static_cast<int>(windows.size()))%static_cast<int>(windows.size());if(switcher_window)InvalidateRect(switcher_window,nullptr,FALSE);}
