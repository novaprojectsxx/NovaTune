    void update_center_status(){auto game=center_selected(false);auto caption=game.empty()?L"No game selected. Add an executable in the library; automatic profiles remain opt-in.":L"SESSION / "+std::wstring(hr::lower(sessions.active_game())==hr::lower(game)&&sessions.active()?L"Active":L"Ready")+L"   /   System CPU "+number(last.cpu)+L"%   /   RAM "+number(last.used)+L" GB\n"+(sessions.error().empty()?L"Review Profile before launch. Unprofiled games use Gaming mode; recorded FPS requires PresentMon.":hr::wide(sessions.error()));if(text(center_status)!=caption)SetWindowTextW(center_status,caption.c_str());if(page==34&&center_session_seen!=sessions.active_id()){center_session_seen=sessions.active_id();SetWindowTextW(center_report,hr::wide(hr::game_center_report(store,game)).c_str());}}
