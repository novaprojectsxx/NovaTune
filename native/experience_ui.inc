    void refresh_center_library(){if(!center_game)return;std::string selected=center_selected(false);center_paths.clear();SendMessageW(center_game,CB_RESETCONTENT,0,0);int chosen=0;for(const auto& game:games){if(game[2]==selected)chosen=static_cast<int>(center_paths.size());center_paths.push_back(game[2]);SendMessageW(center_game,CB_ADDSTRING,0,reinterpret_cast<LPARAM>(hr::wide(game[1]).c_str()));}if(!center_paths.empty())SendMessageW(center_game,CB_SETCURSEL,chosen,0);if(page==34)refresh_center();}
    std::string center_selected(bool required=true){int index=static_cast<int>(SendMessageW(center_game,CB_GETCURSEL,0,0));if(index<0||static_cast<size_t>(index)>=center_paths.size()){if(required)throw std::runtime_error("Add and choose a game first");return {};}return center_paths[index];}
    void select_center_game(){auto game=center_selected();for(size_t n=0;n<games.size();++n)if(games[n][2]==game){ListView_SetItemState(lists[1],-1,0,LVIS_SELECTED);ListView_SetItemState(lists[1],static_cast<int>(n),LVIS_SELECTED,LVIS_SELECTED);return;}throw std::runtime_error("Game library changed; choose the game again");}
