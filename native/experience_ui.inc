    int nav_for_page(int target) const {for(size_t n=0;n<nav_visible.size();++n)if(navigation[nav_visible[n]].page==target)return static_cast<int>(n);return -1;}
    void filter_navigation(){
        if(!nav||navigation_filtering)return;
        navigation_filtering=true;SendMessageW(nav,WM_SETREDRAW,FALSE,0);
        SendMessageW(nav,LB_RESETCONTENT,0,0);nav_visible.clear();
        auto query=global_search?hr::utf8(text(global_search)):std::string{};
        auto append=[&](size_t source){auto row=nav_visible.size();nav_visible.push_back(source);SendMessageW(nav,LB_ADDSTRING,0,reinterpret_cast<LPARAM>(navigation[source].label));SendMessageW(nav,LB_SETITEMDATA,row,navigation[source].page);SendMessageW(nav,LB_SETITEMHEIGHT,row,px(navigation[source].page<0?23:30));};
        for(size_t group=0;group<std::size(navigation);){size_t end=group+1;while(end<std::size(navigation)&&navigation[end].page>=0)++end;bool added=false;for(size_t n=group+1;n<end;++n)if(hr::section_matches(hr::utf8(navigation[n].label),query)){if(!added){append(group);added=true;}append(n);}group=end;}
        SendMessageW(nav,LB_SETCURSEL,nav_for_page(page),0);navigation_filtering=false;
        SendMessageW(nav,WM_SETREDRAW,TRUE,0);ensure_navigation_visible();InvalidateRect(nav,nullptr,TRUE);
    }
