    void initialize_network(){
        network_cards=make(L"STATIC",L"Speed test results",SS_OWNERDRAW,1800,32);network_go=button(L"Start speed test",InternetGo,32);
        network_mode=make(WC_COMBOBOXW,L"",CBS_DROPDOWNLIST|WS_TABSTOP,1802,32);for(auto name:{L"Quick / 12 MiB payload",L"Standard / 80 MiB payload"})SendMessageW(network_mode,CB_ADDSTRING,0,reinterpret_cast<LPARAM>(name));SendMessageW(network_mode,CB_SETCURSEL,0,0);
        network_note=label(L"Cloudflare edge / HTTPS\nPayload plus warm-up/protocol traffic uses your data plan. Click GO to start or stop.",32);
        button(L"Inspect connection",InternetInspect,32);button(L"Flush DNS...",InternetDns,32);button(L"Advanced repair...",InternetRepair,32);button(L"Network settings",InternetSettings,32);
        network_report=make(L"EDIT",hr::wide(store.get("network.last","Ready. Run a speed test, or inspect adapters and suggested connection fixes. Repairs require review and do not guarantee higher bandwidth.")).c_str(),ES_MULTILINE|ES_READONLY|ES_AUTOVSCROLL|WS_VSCROLL,1803,32);
    }
    void layout_network(int left,int content,int bottom){
        position(network_cards,left,114,content,82);position(network_go,left+(content-280)/2,202,280,270);position(network_mode,left,482,220,150);position(network_note,left+238,480,content-238,44);
        const int ids[]={InternetInspect,InternetDns,InternetRepair,InternetSettings};for(int i=0;i<4;++i)position(GetDlgItem(window,ids[i]),left+i*(content/4),536,content/4-10,34);position(network_report,left,584,content,std::max(60,bottom-584));
    }
    void start_network(bool inspect){
        network_busy=true;network_cancel=std::make_shared<std::atomic<bool>>(false);auto cancel=network_cancel;auto live=network_live;{std::lock_guard<std::mutex> lock(live->mutex);if(!inspect)live->value={};live->value.phase=inspect?"Inspecting":"Connecting";}
        EnableWindow(GetDlgItem(window,InternetDns),FALSE);EnableWindow(GetDlgItem(window,InternetRepair),FALSE);EnableWindow(network_mode,FALSE);EnableWindow(GetDlgItem(window,InternetInspect),FALSE);SetWindowTextW(network_go,L"Stop network operation");SetWindowTextW(network_report,inspect?L"Inspecting adapter status and local configuration...":L"Measuring HTTPS latency, then download and upload. Click the circle again to cancel. No settings are changed.");
        bool standard=SendMessageW(network_mode,CB_GETCURSEL,0,0)==1;async(inspect?"internet-inspect":"internet-speed",[cancel,live,standard,inspect](Result& r){r.text=inspect?hr::network_health():hr::internet_speed(standard,*cancel,[live](const hr::NetworkProgress& value){std::lock_guard<std::mutex> lock(live->mutex);live->value=value;});if(inspect){std::lock_guard<std::mutex> lock(live->mutex);live->value.phase="Ready";}});
    }
    bool draw_network(const DRAWITEMSTRUCT& item){
        if(item.hwndItem!=network_go&&item.hwndItem!=network_cards)return false;int w=item.rcItem.right-item.rcItem.left,h=item.rcItem.bottom-item.rcItem.top;if(w<=0||h<=0)return true;
        hr::NetworkProgress state;{std::lock_guard<std::mutex> lock(network_live->mutex);state=network_live->value;}
        HDC dc=CreateCompatibleDC(item.hDC);auto bitmap=CreateCompatibleBitmap(item.hDC,w,h);auto oldbitmap=SelectObject(dc,bitmap);RECT r{0,0,w,h};FillRect(dc,&r,background);SetBkMode(dc,TRANSPARENT);
        auto write=[&](std::wstring value,RECT area,HFONT f,COLORREF color){SelectObject(dc,f);SetTextColor(dc,color);DrawTextW(dc,value.c_str(),-1,&area,DT_CENTER|DT_VCENTER|DT_SINGLELINE|DT_END_ELLIPSIS|DT_NOPREFIX);};
        auto cyan=light_theme?RGB(0,119,145):RGB(53,222,236),purple=light_theme?RGB(116,56,190):RGB(184,123,255),muted=light_theme?RGB(86,96,112):RGB(151,164,184);
        if(item.hwndItem==network_cards){const wchar_t* titles[]={L"DOWNLOAD  /  Mbps",L"UPLOAD  /  Mbps",L"HTTP LATENCY  /  ms"};double values[]={state.download,state.upload,state.latency};for(int n=0;n<3;++n){RECT card{n*w/3+4,1,(n+1)*w/3-8,h-1};auto pen=CreatePen(PS_SOLID,px(1),light_theme?RGB(200,209,221):RGB(41,46,59));auto previous=SelectObject(dc,pen),brush=SelectObject(dc,panel_brush);RoundRect(dc,card.left,card.top,card.right,card.bottom,px(14),px(14));SelectObject(dc,previous);SelectObject(dc,brush);DeleteObject(pen);write(titles[n],{card.left,px(8),card.right,px(29)},font,muted);write(values[n]<0?L"—":number(values[n],2),{card.left,px(32),card.right,h-px(8)},heading_font,n==0?cyan:n==1?purple:ink);}}
        else{int size=std::min(w,h)-px(18),cx=w/2,cy=h/2;auto stroke=[&](int width,COLORREF color,int radius){auto pen=CreatePen(PS_SOLID,width,color);auto old=SelectObject(dc,pen),brush=SelectObject(dc,GetStockObject(NULL_BRUSH));Ellipse(dc,cx-radius,cy-radius,cx+radius,cy+radius);SelectObject(dc,old);SelectObject(dc,brush);DeleteObject(pen);};int radius=size/2;stroke(px(10),light_theme?RGB(215,223,234):RGB(36,42,57),radius);stroke(px(1),network_busy?purple:cyan,radius-px(13));
            const double pi=3.141592653589793;double fraction=std::min(1.0,std::log10(1+std::max(0.0,state.mbps))/3.0);if(network_busy&&(state.phase=="Latency"||state.phase=="Connecting"||state.phase=="Inspecting"))fraction=.12;int count=network_busy?static_cast<int>(270*fraction):270;double offset=network_busy&&state.mbps==0?animation*4.0:135.0;auto pen=CreatePen(PS_SOLID,px(6),state.phase=="Upload"?purple:cyan);auto old=SelectObject(dc,pen);for(int n=0;n<count;++n){double a=(offset+n)*pi/180,b=(offset+n+1)*pi/180;MoveToEx(dc,cx+static_cast<int>(radius*std::cos(a)),cy+static_cast<int>(radius*std::sin(a)),nullptr);LineTo(dc,cx+static_cast<int>(radius*std::cos(b)),cy+static_cast<int>(radius*std::sin(b)));}SelectObject(dc,old);DeleteObject(pen);
            write(network_busy?hr::wide(state.phase):state.phase=="Ready"?L"INTERNET SPEED":hr::wide(state.phase),{0,cy-px(68),w,cy-px(40)},font,muted);write(network_busy?state.mbps>0?number(state.mbps,1):L"•••":L"GO",{0,cy-px(35),w,cy+px(23)},heading_font,ink);write(network_busy?state.mbps>0?L"Mbps   /   click to stop":L"Click to stop":L"START A NEW TEST",{0,cy+px(32),w,cy+px(60)},font,network_busy?purple:cyan);
            if(item.itemState&ODS_FOCUS)stroke(px(1),muted,radius+px(5));}
        BitBlt(item.hDC,item.rcItem.left,item.rcItem.top,w,h,dc,0,0,SRCCOPY);SelectObject(dc,oldbitmap);DeleteObject(bitmap);DeleteDC(dc);return true;
    }
