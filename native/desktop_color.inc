    struct ColorDialog {Impl* self;COLORREF value;HWND window=nullptr;bool accepted=false,updating=false;};
    static std::wstring color_hex(COLORREF value){wchar_t text[8]{};swprintf(text,8,L"#%02X%02X%02X",GetRValue(value),GetGValue(value),GetBValue(value));return text;}
    static void color_update(ColorDialog& dialog){dialog.updating=true;SetWindowTextW(GetDlgItem(dialog.window,804),color_hex(dialog.value).c_str());int values[]={GetRValue(dialog.value),GetGValue(dialog.value),GetBValue(dialog.value)};for(int n=0;n<3;++n)SendMessageW(GetDlgItem(dialog.window,801+n),TBM_SETPOS,TRUE,values[n]);dialog.updating=false;InvalidateRect(dialog.window,nullptr,FALSE);}
    static LRESULT CALLBACK color_proc(HWND h,UINT msg,WPARAM w,LPARAM l){auto dialog=reinterpret_cast<ColorDialog*>(GetWindowLongPtrW(h,GWLP_USERDATA));if(msg==WM_NCCREATE){dialog=static_cast<ColorDialog*>(reinterpret_cast<CREATESTRUCTW*>(l)->lpCreateParams);dialog->window=h;SetWindowLongPtrW(h,GWLP_USERDATA,reinterpret_cast<LONG_PTR>(dialog));}if(!dialog)return DefWindowProcW(h,msg,w,l);auto self=dialog->self;static const COLORREF palette[]={RGB(26,242,44),RGB(180,95,255),RGB(0,216,255),RGB(255,183,66),RGB(255,70,100),RGB(236,240,247),RGB(13,13,17),RGB(25,25,31),RGB(40,65,95),RGB(0,145,125),RGB(255,115,45),RGB(200,80,220)};if(msg==WM_ERASEBKGND)return 1;if(msg==WM_CREATE){auto make=[&](const wchar_t* cls,const wchar_t* text,DWORD style,int id,int x,int y,int width,int height){auto child=CreateWindowExW(0,cls,text,WS_CHILD|WS_VISIBLE|style,self->px(x),self->px(y),self->px(width),self->px(height),h,reinterpret_cast<HMENU>(static_cast<INT_PTR>(id)),GetModuleHandleW(nullptr),nullptr);SendMessageW(child,WM_SETFONT,reinterpret_cast<WPARAM>(self->font),0);return child;};for(int n=0;n<3;++n){auto slider=make(TRACKBAR_CLASSW,L"",WS_TABSTOP|TBS_NOTICKS,801+n,44,94+n*44,326,32);SendMessageW(slider,TBM_SETRANGE,TRUE,MAKELPARAM(0,255));}make(L"EDIT",L"",WS_TABSTOP|ES_AUTOHSCROLL,804,24,238,190,32);SendMessageW(GetDlgItem(h,804),EM_SETLIMITTEXT,7,0);for(int n=0;n<12;++n)make(L"BUTTON",L"",BS_OWNERDRAW|WS_TABSTOP,810+n,24+(n%6)*62,290+(n/6)*44,52,34);make(L"BUTTON",L"Apply color",BS_OWNERDRAW|WS_TABSTOP,IDOK,188,400,106,34);make(L"BUTTON",L"Cancel",BS_OWNERDRAW|WS_TABSTOP,IDCANCEL,304,400,82,34);color_update(*dialog);return 0;}if(msg==WM_PAINT){PAINTSTRUCT p{};auto dc=BeginPaint(h,&p);RECT r{};GetClientRect(h,&r);fill(dc,r,self->bg());SelectObject(dc,self->font);text(dc,L"CUSTOM COLOR",{self->px(24),self->px(12),self->px(270),self->px(48)},self->fg());rounded(dc,{self->px(292),self->px(18),self->px(382),self->px(74)},dialog->value,dialog->value,10);text(dc,L"RGB sliders or #RRGGBB",{self->px(24),self->px(48),self->px(280),self->px(78)},muted);for(int n=0;n<3;++n)text(dc,n==0?L"R":n==1?L"G":L"B",{self->px(24),self->px(94+n*44),self->px(44),self->px(126+n*44)},self->fg());EndPaint(h,&p);return 0;}if(msg==WM_HSCROLL&&!dialog->updating){int values[3]{};for(int n=0;n<3;++n)values[n]=static_cast<int>(SendMessageW(GetDlgItem(h,801+n),TBM_GETPOS,0,0));dialog->value=RGB(values[0],values[1],values[2]);color_update(*dialog);return 0;}if(msg==WM_NOTIFY){auto draw=reinterpret_cast<NMCUSTOMDRAW*>(l);if(draw->hdr.code==NM_CUSTOMDRAW){if(draw->dwDrawStage==CDDS_PREPAINT)return CDRF_NOTIFYITEMDRAW;if(draw->dwDrawStage==CDDS_ITEMPREPAINT){if(draw->dwItemSpec==TBCD_CHANNEL){fill(draw->hdc,draw->rc,self->field_bg());return CDRF_SKIPDEFAULT;}if(draw->dwItemSpec==TBCD_THUMB){rounded(draw->hdc,draw->rc,dialog->value,self->fg(),8);return CDRF_SKIPDEFAULT;}}}}if(msg==WM_COMMAND){int id=LOWORD(w);if(id>=810&&id<822){dialog->value=palette[id-810];color_update(*dialog);return 0;}if(id==IDCANCEL){DestroyWindow(h);return 0;}if(id==IDOK){auto value=read_text(GetDlgItem(h,804));if(value.size()!=7||value[0]!=L'#'||value.find_first_not_of(L"0123456789abcdefABCDEF",1)!=std::wstring::npos){app_dialog(h,L"Color",L"Enter a color as #RRGGBB.",false,self->light);return 0;}auto number=std::stoul(value.substr(1),nullptr,16);dialog->value=RGB((number>>16)&255,(number>>8)&255,number&255);dialog->accepted=true;DestroyWindow(h);return 0;}}if(msg==WM_DRAWITEM){auto item=reinterpret_cast<DRAWITEMSTRUCT*>(l);if(item->CtlID>=810&&item->CtlID<822){rounded(item->hDC,item->rcItem,palette[item->CtlID-810],self->fg(),8);return TRUE;}return self->draw_control(*item);}if(msg==WM_CTLCOLOREDIT||msg==WM_CTLCOLORSTATIC)return self->colors(msg,w);if(msg==WM_CLOSE){DestroyWindow(h);return 0;}return DefWindowProcW(h,msg,w,l);}
    COLORREF pick_color(COLORREF initial){static std::once_flag registered;std::call_once(registered,[]{WNDCLASSW cls{};cls.hInstance=GetModuleHandleW(nullptr);cls.lpfnWndProc=color_proc;cls.hCursor=LoadCursorW(nullptr,IDC_ARROW);cls.lpszClassName=L"HeadroomColorPicker";RegisterClassW(&cls);});ColorDialog dialog{this,initial};RECT r{};GetWindowRect(owner,&r);HWND window=CreateWindowExW(WS_EX_DLGMODALFRAME,L"HeadroomColorPicker",L"NovaTune color picker",WS_POPUP|WS_CAPTION|WS_SYSMENU,r.left+px(130),r.top+px(80),px(420),px(490),owner,nullptr,GetModuleHandleW(nullptr),&dialog);if(!window)throw std::runtime_error("Cannot open color picker");BOOL dark=!light;DwmSetWindowAttribute(window,20,&dark,sizeof dark);COLORREF border=0xFFFFFFFE;DwmSetWindowAttribute(window,34,&border,sizeof border);EnableWindow(owner,FALSE);ShowWindow(window,SW_SHOW);MSG msg{};while(IsWindow(window)){int result=GetMessageW(&msg,nullptr,0,0);if(result<=0){if(!result)PostQuitMessage(static_cast<int>(msg.wParam));DestroyWindow(window);break;}if(msg.message==WM_KEYDOWN&&msg.wParam==VK_ESCAPE){DestroyWindow(window);break;}if(!IsDialogMessageW(window,&msg)){TranslateMessage(&msg);DispatchMessageW(&msg);}}EnableWindow(owner,TRUE);SetForegroundWindow(owner);return dialog.accepted?dialog.value:initial;}
